# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Both are required: src/lib/supabase.ts
# asserts them non-null, so the app fails at startup without them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put a service role key in a NEXT_PUBLIC_ variable — anything with
# that prefix is bundled into the JavaScript the browser downloads.
