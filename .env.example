# Sayt manzili (sitemap, OpenGraph). Vercel'da odatda shart emas.
NEXT_PUBLIC_SITE_URL=https://www.maxmiles.uz

# Telegram bot (foydalanuvchi uchun buyurtma havolasi). Bo'sh bo'lsa — maxmile_oil_bot.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram bot @maxmile_oil_bot — mijozlar bilan aloqa (server tomonida, NEXT_PUBLIC_ EMAS!).
# Mijoz xabarlari, saytdan kelgan buyurtmalar va «Aloqa» formasi TELEGRAM_CHAT_ID chatiga keladi;
# menejer shu xabarlarga Reply qilsa, javob bot orqali mijozga qaytadi. Chat ID: botga /id yozing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ixtiyoriy: webhook siri (bo'sh bo'lsa tokendan hosil qilinadi)
TELEGRAM_WEBHOOK_SECRET=
# Faqat mahalliy sinov: 1 bo'lsa `npm run dev` botni getUpdates orqali ishlatadi (webhook o'chirilgan bo'lishi kerak)
TELEGRAM_POLLING=
